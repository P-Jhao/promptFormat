# Copy this file to backend/.env on the server. Never commit backend/.env.

NODE_ENV=production
HOST=0.0.0.0
PORT=7001
TRUST_PROXY_HOPS=1
CORS_ORIGINS=http://promptforge.pjhao.xyz,https://promptforge.pjhao.xyz

# Public chat protection. Values are process-local and require no database.
CHAT_REQUEST_TIMEOUT_MS=900000
CHAT_RATE_LIMIT_WINDOW_MS=600000
CHAT_RATE_LIMIT_MAX_REQUESTS=5
CHAT_MAX_CONCURRENT_REQUESTS_PER_IP=1

# Set true for a no-key smoke test. Set false to call the selected provider.
MOCK_MODE=false
MAIN_MODEL_PROVIDER=gpt

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# OPENAI_REASONING_EFFORT=medium

# Use these when MAIN_MODEL_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
# DEEPSEEK_REASONING_EFFORT=medium

# Upload is outside this deployment scope; leave empty unless it is enabled later.
ALI_OSS_AK=
ALI_OSS_SK=
ALI_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALI_OSS_BUCKET=
